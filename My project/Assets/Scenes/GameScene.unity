--- !u!1001 &1444588534
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1680615337}
    m_Modifications:
    - target: {fileID: 2832206619173887839, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: m_Name
      value: NPC3
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: messageUI
