  conditions:
  - title: "\u0411\u0430\u0437\u043E\u0432\u044B\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F"
    description: "\u0416\u0438\u0434\u043A\u0430\u044F \u0432\u043E\u0434\u0430 \u0438
      \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B.
      \u0422\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u0430\u044F."
    minTemp: -10
    maxTemp: 50
    needsWater: 1
    needsAtmosphere: 1
  - title: "\u0425\u043E\u043B\u043E\u0434\u043D\u044B\u0439 \u043C\u0438\u0440"
    description: "\u0412\u043E\u0434\u0430 \u043D\u0443\u0436\u043D\u0430 \u0432
      \u043B\u044E\u0431\u043E\u043C \u0432\u0438\u0434\u0435. \u0410\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430
      \u043D\u0435 \u0432\u0430\u0436\u043D\u0430. \u041E\u0447\u0435\u043D\u044C
      \u0445\u043E\u043B\u043E\u0434\u043D\u043E."
    minTemp: -100
    maxTemp: -20
    needsWater: 1
    needsAtmosphere: 0
  - title: "\u041F\u0443\u0441\u0442\u044B\u043D\u043D\u044B\u0439 \u0441\u0435\u043A\u0442\u043E\u0440"
    description: "\u0412\u043E\u0434\u044B \u043D\u0435\u0442. \u0410\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430
      \u0435\u0441\u0442\u044C. \u0416\u0430\u0440\u043A\u043E."
    minTemp: 80
    maxTemp: 150
    needsWater: 0
    needsAtmosphere: 1
  - title: "\u042D\u043A\u0441\u0442\u0440\u0435\u043C\u0430\u043B\u044C\u043D\u0430\u044F
      \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044F"
    description: "\u0411\u0435\u0437 \u0432\u043E\u0434\u044B, \u0431\u0435\u0437
      \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u044B. \u0423\u043C\u0435\u0440\u0435\u043D\u043D\u044B\u0439
      \u043A\u043B\u0438\u043C\u0430\u0442."
    minTemp: 0
    maxTemp: 40
    needsWater: 0
    needsAtmosphere: 0
  - title: "\u041B\u0435\u0434\u044F\u043D\u043E\u0439 \u0433\u0438\u0433\u0430\u043D\u0442"
