      \u041B\u0430\u043D\u0438\u0430\u043A\u0435\u044F"
    wrong1: "\u0421\u0432\u0435\u0440\u0445\u0441\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u0435
      \u041F\u0435\u0440\u0441\u0435\u044F-\u041F\u0435\u0433\u0430\u0441\u0430"
    wrong2: "\u0421\u0432\u0435\u0440\u0445\u0441\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u0435
      \u0412\u043E\u043B\u043E\u0441 \u0412\u0435\u0440\u043E\u043D\u0438\u043A\u0438"
  - correct: "\u0421\u0432\u0435\u0440\u0445\u0441\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u0435
      \u0414\u0435\u0432\u044B"
    wrong1: "\u0421\u0432\u0435\u0440\u0445\u0441\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u0435
      \u041F\u0435\u0447\u0438"
    wrong2: "\u0421\u0432\u0435\u0440\u0445\u0441\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u0435
      \u042D\u0440\u0438\u0434\u0430\u043D\u0430"
  - correct: "\u041C\u0435\u0441\u0442\u043D\u0430\u044F \u0433\u0440\u0443\u043F\u043F\u0430
      \u0433\u0430\u043B\u0430\u043A\u0442\u0438\u043A"
    wrong1: "\u0421\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u0435 \u0414\u0435\u0432\u044B"
    wrong2: "\u041C\u0435\u0441\u0442\u043D\u043E\u0435 \u043E\u0431\u043B\u0430\u043A\u043E"
  - correct: "\u0413\u0430\u043B\u0430\u043A\u0442\u0438\u043A\u0430 \u041C\u043B\u0435\u0447\u043D\u044B\u0439
      \u041F\u0443\u0442\u044C"
    wrong1: "\u0413\u0430\u043B\u0430\u043A\u0442\u0438\u043A\u0430 \u0410\u043D\u0434\u0440\u043E\u043C\u0435\u0434\u044B"
    wrong2: "\u0413\u0430\u043B\u0430\u043A\u0442\u0438\u043A\u0430 \u0422\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A\u0430"
  - correct: "\u0420\u0443\u043A\u0430\u0432 \u041E\u0440\u0438\u043E\u043D\u0430"
    wrong1: "\u0420\u0443\u043A\u0430\u0432 \u041F\u0435\u0440\u0441\u0435\u044F"
    wrong2: "\u0420\u0443\u043A\u0430\u0432 \u0421\u0442\u0440\u0435\u043B\u044C\u0446\u0430"
  - correct: "\u0421\u043E\u043B\u043D\u0435\u0447\u043D\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430"
    wrong1: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u0410\u043B\u044C\u0444\u0430
