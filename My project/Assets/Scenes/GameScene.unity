--- !u!114 &2025651177
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2025651175}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\t\u0415\u0441\u043B\u0438 \u0432\u044B \u0445\u043E\u0442\u0438\u0442\u0435
    \u043D\u0430\u0439\u0442\u0438 \u0441\u0432\u043E\u044E \u043F\u043B\u0430\u043D\u0435\u0442\u0443,
    \u043D\u0430\u0447\u043D\u0451\u043C \u0441 \u0441\u0430\u043C\u043E\u0433\u043E
    \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E. \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C\u0442\u0435
    \u0441\u0435\u0431\u0435 \u0412\u0441\u0435\u043B\u0435\u043D\u043D\u0443\u044E
    \u2014 \u044D\u0442\u043E \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0439
    \u043E\u043A\u0435\u0430\u043D, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
    \u043F\u043B\u0430\u0432\u0430\u044E\u0442 \u0433\u0438\u0433\u0430\u043D\u0442\u0441\u043A\u0438\u0435
    \u043F\u0443\u0437\u044B\u0440\u0438 \u0438\u0437 \u0433\u0430\u043B\u0430\u043A\u0442\u0438\u043A.
    \u0412\u0430\u0448 \u043F\u0443\u0437\u044B\u0440\u044C \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u0441\u0432\u0435\u0440\u0445\u0441\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u0439
    \u0420\u044B\u0431-\u041A\u0438\u0442\u0430, \u044D\u0442\u043E \u043E\u0434\u043D\u0430
    \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0445
    \u043D\u0438\u0442\u0435\u0439 \u0432 \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043F\u0430\u0443\u0442\u0438\u043D\u0435.\r\n\t\u0412\u043D\u0443\u0442\u0440\u0438
    \u044D\u0442\u043E\u0433\u043E \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430
    \u0434\u0440\u0435\u0439\u0444\u0443\u0435\u0442 \u0441\u0432\u0435\u0440\u0445\u0441\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u0435
    \u041B\u0430\u043D\u0438\u0430\u043A\u0435\u044F. \u041D\u0430 \u043C\u0435\u0441\u0442\u043D\u043E\u043C
    \u043D\u0430\u0440\u0435\u0447\u0438\u0438 \u044D\u0442\u043E \u0441\u043B\u043E\u0432\u043E
    \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \xAB\u043D\u0435\u043E\u0431\u044A\u044F\u0442\u043D\u044B\u0435
    \u043D\u0435\u0431\u0435\u0441\u0430\xBB, \u0438 \u044D\u0442\u043E \u043F\u0440\u0430\u0432\u0434\u0430
    \u0442\u0430\u043A. \u041B\u0430\u043D\u0438\u0430\u043A\u0435\u044F \u043F\u043E\u0445\u043E\u0436\u0430
    \u043D\u0430 \u0433\u0438\u0433\u0430\u043D\u0442\u0441\u043A\u0443\u044E \u043F\u0430\u0443\u0442\u0438\u043D\u0443,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0442\u0435\u0447\u0451\u0442 \u0432
    \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439
    \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0438 \u2014 \u0412\u0435\u043B\u0438\u043A\u043E\u0433\u043E
    \u0410\u0442\u0442\u0440\u0430\u043A\u0442\u043E\u0440\u0430. \u041D\u043E \u0432\u0430\u0448\u0430
    \u0446\u0435\u043B\u044C \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u043D\u0435 \u0432 \u0446\u0435\u043D\u0442\u0440\u0435 \u044D\u0442\u043E\u0433\u043E
    \u043F\u043E\u0442\u043E\u043A\u0430, \u0430 \u043D\u0430 \u043E\u043A\u0440\u0430\u0438\u043D\u0435,
    \u0432 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u043C \u0444\u0438\u043B\u0438\u0430\u043B\u0435
    \u2014 \u0421\u0432\u0435\u0440\u0445\u0441\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u0438
    \u0414\u0435\u0432\u044B.\r\n\u0421\u0432\u0435\u0440\u0445\u0441\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u0435
    \u0414\u0435\u0432\u044B \u2014 \u044D\u0442\u043E \u0443\u0436\u0435 \u0447\u0442\u043E-\u0442\u043E
    \u0431\u043E\u043B\u0435\u0435 \u0443\u044E\u0442\u043D\u043E\u0435. \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C\u0442\u0435
    \u0441\u0435\u0431\u0435 \u0448\u0443\u043C\u043D\u044B\u0439 \u043C\u0435\u0433\u0430\u043F\u043E\u043B\u0438\u0441
    \u0438\u0437 \u0442\u044B\u0441\u044F\u0447 \u0433\u0430\u043B\u0430\u043A\u0442\u0438\u043A.
    \u0412\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u043E\u0442\u044B\u0441\u043A\u0430\u0442\u044C
    \u0442\u0438\u0445\u0438\u0439 \u0441\u043F\u0430\u043B\u044C\u043D\u044B\u0439
    \u0440\u0430\u0439\u043E\u043D \u043D\u0430 \u043E\u043A\u0440\u0430\u0438\u043D\u0435
    \u044D\u0442\u043E\u0433\u043E \u043C\u0435\u0433\u0430\u043F\u043E\u043B\u0438\u0441\u0430.
    \u041E\u043D \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u041C\u0435\u0441\u0442\u043D\u0430\u044F
    \u0433\u0440\u0443\u043F\u043F\u0430 \u0433\u0430\u043B\u0430\u043A\u0442\u0438\u043A.
    \u0417\u0434\u0435\u0441\u044C \u0432\u0441\u0435\u0433\u043E \u043E\u043A\u043E\u043B\u043E
    \u043F\u044F\u0442\u0438\u0434\u0435\u0441\u044F\u0442\u0438 \u043A\u0440\u0443\u043F\u043D\u044B\u0445
    \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432, \u043D\u043E \u0432\u0430\u043C
    \u043D\u0443\u0436\u043D\u0430 \u043E\u0434\u043D\u0430 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0430\u044F
    \u0437\u0432\u0451\u0437\u0434\u043D\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430.\r\n\t\u0412
    \u044D\u0442\u043E\u0439 \u0441\u0430\u043C\u043E\u0439 \u041C\u0435\u0441\u0442\u043D\u043E\u0439
    \u0433\u0440\u0443\u043F\u043F\u0435 \u043A\u0440\u0443\u0436\u0438\u0442\u0441\u044F
    \u043A\u0440\u0430\u0441\u0438\u0432\u0430\u044F \u0441\u043F\u0438\u0440\u0430\u043B\u044C
    \u2014 \u0433\u0430\u043B\u0430\u043A\u0442\u0438\u043A\u0430 \u041C\u043B\u0435\u0447\u043D\u044B\u0439
    \u041F\u0443\u0442\u044C. \u0412\u044B, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
    \u0432\u0438\u0434\u0435\u043B\u0438 \u0435\u0451 \u0441 \u043F\u043B\u0430\u043D\u0435\u0442\u044B
    \u043A\u0430\u043A \u0441\u0432\u0435\u0442\u043B\u0443\u044E \u043F\u043E\u043B\u043E\u0441\u0443
    \u043D\u0430 \u043D\u043E\u0447\u043D\u043E\u043C \u043D\u0435\u0431\u0435. \u041D\u0430\u0448\u0430
    \u0446\u0435\u043B\u044C \u2014 \u043D\u0435 \u0432 \u0446\u0435\u043D\u0442\u0440\u0435
    \u044D\u0442\u043E\u0439 \u0441\u043F\u0438\u0440\u0430\u043B\u0438, \u0442\u0430\u043C
    \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0448\u0443\u043C\u043D\u043E \u0438
    \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E, \u0430 \u043F\u043E\u0447\u0442\u0438
    \u043D\u0430 \u043E\u043A\u0440\u0430\u0438\u043D\u0435, \u0432 \u043E\u0434\u043D\u043E\u043C
    \u0438\u0437 \u0441\u043F\u0438\u0440\u0430\u043B\u044C\u043D\u044B\u0445 \u0440\u0443\u043A\u0430\u0432\u043E\u0432,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0430\u0441\u0442\u0440\u043E\u043D\u043E\u043C\u044B
    \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0440\u0443\u043A\u0430\u0432\u043E\u043C
    \u041E\u0440\u0438\u043E\u043D\u0430.\r\n\t\u0410 \u0432\u043E\u0442 \u0442\u0443\u0442
    \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0441\u0430\u043C\u043E\u0435
    \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E\u0435. \u0412 \u0440\u0443\u043A\u0430\u0432\u0435
    \u041E\u0440\u0438\u043E\u043D\u0430, \u0441\u0440\u0435\u0434\u0438 \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u043E\u0432
    \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0445 \u0433\u0430\u0437\u043E\u0432\u044B\u0445
    \u0433\u0438\u0433\u0430\u043D\u0442\u043E\u0432 \u0438 \u0440\u0430\u0441\u043A\u0430\u043B\u0451\u043D\u043D\u044B\u0445
    \u0437\u0432\u0451\u0437\u0434, \u0435\u0441\u0442\u044C \u043E\u0434\u043D\u0430
    \u043D\u0435\u043F\u0440\u0438\u043C\u0435\u0442\u043D\u0430\u044F \u0436\u0451\u043B\u0442\u0430\u044F
    \u043A\u0430\u0440\u043B\u0438\u043A\u043E\u0432\u0430\u044F \u0437\u0432\u0435\u0437\u0434\u0430.
    \u041B\u044E\u0434\u0438 \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0435\u0451
    \u0421\u043E\u043B\u043D\u0446\u0435. \u0412\u043E\u043A\u0440\u0443\u0433 \u043D\u0435\u0451
    \u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F 8 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0445
    \u043F\u043B\u0430\u043D\u0435\u0442. \u0418 \u043E\u0434\u043D\u0430 \u0438\u0437
    \u043D\u0438\u0445\u2026 \u0442\u0440\u0435\u0442\u044C\u044F \u043F\u043E \u0441\u0447\u0451\u0442\u0443
    \u043E\u0442 \u0437\u0432\u0435\u0437\u0434\u044B. \u041D\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u0433\u043E\u0440\u044F\u0447\u043E, \u043D\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u0445\u043E\u043B\u043E\u0434\u043D\u043E. \u041D\u0430 \u043D\u0435\u0439 \u0435\u0441\u0442\u044C
    \u0436\u0438\u0434\u043A\u0430\u044F \u0432\u043E\u0434\u0430 \u0438, \u0447\u0442\u043E
    \u0441\u0430\u043C\u043E\u0435 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435,
    \u0436\u0438\u0437\u043D\u044C, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0443\u043C\u0443\u0434\u0440\u0438\u043B\u0430\u0441\u044C
    \u0441\u0442\u0430\u0442\u044C \u0440\u0430\u0437\u0443\u043C\u043D\u043E\u0439
    \u0438 \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043A\u043E\u0440\u0430\u0431\u043B\u0438.\r\n\r\n\r\n\u041E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
    \u0447\u0442\u043E \u0441\u043B\u043E\u043C\u0430\u043B\u0430\u0441\u044C \u0441\u0438\u0441\u0442\u0435\u043C\u0430
    \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438 \u043A\u043E\u0440\u0430\u0431\u043B\u044F
    \u0438 \u0442\u0435\u043F\u0435\u0440\u044C \u043C\u044B \u043D\u0435 \u0437\u043D\u0430\u0435\u043C,
    \u0433\u0434\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043A\u043E\u0440\u0430\u0431\u043B\u044C.
    \u041D\u0443\u0436\u043D\u043E \u0432\u0440\u0443\u0447\u043D\u0443\u044E \u0432\u0432\u0435\u0441\u0442\u0438
