    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: dialogueAfter.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: dialogueBefore.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueAfter.Array.data[0]'
      value: "\u041F\u0440\u0438\u0448\u0435\u043B\u0435\u0446: \u041A\u0430\u043A\u0430\u044F
        \u0440\u0430\u0434\u043E\u0441\u0442\u044C, \u044F \u0431\u0443\u0434\u0442\u043E
        \u043F\u0430\u0440\u044E \u043E\u0442 \u0441\u0447\u0430\u0441\u0442\u044C\u044F.
        \u0414\u0430\u0436\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0436\u0430\u043B\u044C,
        \u0447\u0442\u043E \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044F
        \u0441\u043D\u043E\u0432\u0430 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u0430,
        \u0445\u0430-\u0445\u0430."
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueAfter.Array.data[1]'
      value: "\u041F\u0440\u0438\u0448\u0435\u043B\u0435\u0446: \u0412\u0441\u0451
        \u0442\u0430\u043A\u0438 \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044F
        - \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
        \u0448\u0442\u0443\u043A\u0430. \u0414\u0443\u043C\u0430\u044E \u043C\u043E\u0436\u043D\u043E
        \u0435\u0451 \u043D\u0430\u0437\u0432\u0430\u0442\u044C \u0441\u0430\u043C\u043E\u0439
        \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0437\u0430\u0433\u0430\u0434\u043A\u043E\u0439
        \u043D\u0430\u0448\u0435\u0439 \u0412\u0441\u0435\u043B\u0435\u043D\u043D\u043E\u0439."
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueAfter.Array.data[2]'
      value: "\u041F\u0440\u0438\u0448\u0435\u043B\u0435\u0446: \u041E\u043D\u0430
        \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u044E\u043D\u044B\u043C \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044F\u043C
        \u043A\u043E\u0441\u043C\u043E\u0441\u0430 \u0441\u0442\u043E\u043B\u044C\u043A\u043E
        \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u0435\u0439, \u043D\u043E
        \u0431\u0435\u0437 \u043D\u0435\u0451 \u043A\u043E\u0441\u043C\u043E\u0441\u0430
        \u0431\u044B \u0438 \u0432\u043E\u0432\u0441\u0435 \u043D\u0435 \u0431\u044B\u043B\u043E.\t"
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueAfter.Array.data[3]'
      value: "\u041F\u0440\u0438\u0448\u0435\u043B\u0435\u0446: \u041F\u0430\u0440\u0430\u0434\u043E\u043A\u0441!"
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueAfter.Array.data[4]'
      value: "\u041F\u0440\u0438\u0448\u0435\u043B\u0435\u0446: \u041F\u043E\u0441\u043B\u0435
        \u044D\u0442\u043E\u0433\u043E \u0441\u043B\u0443\u0447\u0430\u044F \u043A
        \u0432\u0430\u0448\u0435\u0439 \u043F\u043B\u0430\u043D\u0435\u0442\u0435
        \u0432\u043E\u0437\u043D\u0438\u043A \u043E\u0441\u043E\u0431\u044B\u0439
        \u0438\u043D\u0442\u0435\u0440\u0435\u0441. \u041C\u044B \u0441 \u043D\u0435\u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435\u043C
        \u0436\u0434\u0451\u043C, \u043A\u043E\u0433\u0434\u0430 \u043B\u044E\u0434\u0438
        \u0441\u043C\u043E\u0433\u0443\u0442 \u043D\u0430\u0447\u0430\u0442\u044C
        \u0441\u0432\u043E\u044E \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0443\u044E
        \u044D\u0440\u0443."
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueAfter.Array.data[5]'
      value: "\u041F\u0440\u0438\u0448\u0435\u043B\u0435\u0446: \u0410 \u043F\u043E\u043A\u0430,
        \u043C\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0435\u043C.
        \u041D\u0443, \u0438 \u0438\u043D\u043E\u0433\u0434\u0430 \u043D\u0430\u0432\u0435\u0449\u0430\u0435\u043C
        \u0432\u0430\u0441, \u043D\u0430 \u0432\u0441\u044F\u043A\u0438\u0439 \u0441\u043B\u0443\u0447\u0430\u0439."
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueAfter.Array.data[6]'
      value: "\u041F\u0440\u0438\u0448\u0435\u043B\u0435\u0446: \xAB\u0414\u0430
        \u0437\u043D\u0430\u044E \u044F, \u043A\u043E\u043D\u0441\u0435\u0440\u0432\u0430!
        \u0427\u0435\u043B\u043E\u0432\u0435\u043A, \u0441\u043A\u043E\u0440\u0435\u0435
        \u0434\u0432\u0438\u0433\u0430\u0439\u0441\u044F \u0434\u0430\u043B\u044C\u0448\u0435!
        \u0410 \u044F \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0443 \u0430\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C.
        \u0413\u0434\u0435 \u0436\u0435 \u043C\u043E\u0439 \u0440\u0430\u0444 \u043D\u0430
        \u0443\u0433\u043B\u0435\u0432\u043E\u0434\u043D\u043E\u043C \u043C\u043E\u043B\u043E\u043A\u0435\u2026\xBB"
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: "*\u041F\u0440\u0438\u0448\u0435\u043B\u0435\u0446 \u0438\u0437\u0434\u0430\u0451\u0442
        \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u044B\u0435 \u0437\u0432\u0443\u043A\u0438*"
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueBefore.Array.data[0]'
      value: "\u041F\u0440\u0438\u0448\u0435\u043B\u0435\u0446: \u0427\u0442\u043E
        \u0436\u0435 \u0434\u0435\u043B\u0430\u0442\u044C?.."
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueBefore.Array.data[1]'
      value: "\u041F\u0440\u0438\u0448\u0435\u043B\u0435\u0446: \u0427\u0435\u043B\u043E\u0432\u0435\u043A!
        \u0421\u043B\u0430\u0432\u0430 \u043C\u0435\u0436\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
        \u0431\u043E\u0433\u0430\u043C \u0442\u044B \u0437\u0434\u0435\u0441\u044C.
        \u0422\u044B \u043C\u043D\u0435 \u0441\u0440\u043E\u0447\u043D\u043E \u043D\u0443\u0436\u0435\u043D!"
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueBefore.Array.data[2]'
      value: "\u041F\u0440\u0438\u0448\u0435\u043B\u0435\u0446: \u0413\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u0430\u044F
        \u043A\u043E\u043C\u043D\u0430\u0442\u0430 \u0441\u0442\u0430\u043B\u0430
        \u0430\u043D\u0442\u0438\u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439,
        \u0438 \u0442\u0435\u043F\u0435\u0440\u044C \u044F \u043D\u0435 \u043C\u043E\u0433\u0443
        \u0442\u0443\u0434\u0430 \u043F\u043E\u043F\u0430\u0441\u0442\u044C."
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueBefore.Array.data[3]'
      value: "\u041F\u0440\u0438\u0448\u0435\u043B\u0435\u0446: \u041D\u0443\u0436\u043D\u043E
        \u0441\u043D\u043E\u0432\u0430 \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C
        \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0435
        \u043F\u043E\u043B\u0435, \u043D\u043E \u0443 \u043C\u0435\u043D\u044F \u043D\u0435\u0442
        \u043D\u0443\u0436\u043D\u043E\u0433\u043E \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F\u2026
        \u0410 \u0432\u043E\u0442 \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C
        \u0440\u0430\u043D\u0435\u0446!"
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueBefore.Array.data[4]'
      value: "\u041F\u0440\u0438\u0448\u0435\u043B\u0435\u0446: \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
        \u043F\u0440\u043E\u043B\u0435\u0442\u0438 \u043F\u043E \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0443
        \u0438 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u0439 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
        \u0441\u043D\u043E\u0432\u0430."
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueBefore.Array.data[5]'
      value: "\u041F\u0440\u0438\u0448\u0435\u043B\u0435\u0446: \u0422\u043E\u043B\u044C\u043A\u043E
        \u043E\u0441\u0442\u0435\u0440\u0435\u0433\u0430\u0439\u0441\u044F \u043B\u0430\u0437\u0435\u0440\u043E\u0432
        \u0438 \u043D\u0435 \u043A\u0430\u0441\u0430\u0439\u0441\u044F \u0441\u0442\u0435\u043D!"
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: dialogueAfterSolve.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: dialogueBeforeSolve.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueAfterSolve.Array.data[0]'
      value: "\u041F\u0440\u0438\u0448\u0435\u043B\u0435\u0446: \xAB\u0410, \u0442\u0430\u043A
        \u0442\u044B \u0417\u0435\u043C\u043B\u044F\u043D\u0438\u043D! \u0417\u0434\u043E\u0440\u043E\u0432\u043E
        \u0436\u0435 \u0442\u044B \u043C\u0435\u043D\u044F \u043D\u0430\u043F\u0443\u0433\u0430\u043B.
        \u042F \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u043A \u044D\u0442\u043E\u0433\u043E
        \u043A\u043E\u0440\u0430\u0431\u043B\u044F, \u0441\u043B\u0435\u0436\u0443
        \u0437\u0430 \u0432\u0441\u044F\u043A\u0438\u043C\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044F\u043C\u0438.\xBB"
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueAfterSolve.Array.data[1]'
      value: "\u041F\u0440\u0438\u0448\u0435\u043B\u0435\u0446: \xAB\u041A\u0430\u043A
        \u0442\u044B \u0437\u0434\u0435\u0441\u044C \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F?!
        \u0414\u0435\u043D\u044C \u043F\u043E\u0445\u0438\u0449\u0435\u043D\u0438\u0439
        \u0436\u0435 \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u043D\u0430
        \u043F\u043E\u0441\u043B\u0435\u0437\u0430\u0432\u0442\u0440\u0430!\xBB"
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueAfterSolve.Array.data[2]'
      value: "\u0411\u043E\u0440\u0442\u043E\u0432\u043E\u0439 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440:
        \xAB\u0412\u043E\u043E\u0431\u0449\u0435-\u0442\u043E, \u043D\u0430 \u0437\u0430\u0432\u0442\u0440\u0430.\xBB"
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueAfterSolve.Array.data[3]'
      value: "\u041F\u0440\u0438\u0448\u0435\u043B\u0435\u0446: \xAB\u0427\u0422\u041E?
        \u0423 \u043D\u0430\u0441 \u0436\u0435 \u0432\u0441\u0451 \u0435\u0449\u0451
        \u043D\u0435 \u0438\u0441\u043F\u0440\u0430\u0432\u0435\u043D \u043A\u043E\u0440\u0430\u0431\u043B\u044C!
        \u041F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0438 \u0437\u0430\u0448\u043A\u0430\u043B\u0438\u0432\u0430\u044E\u0442!\xBB"
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueAfterSolve.Array.data[4]'
      value: "\u041F\u0440\u0438\u0448\u0435\u043B\u0435\u0446: \xAB\u0427\u0435\u043B\u043E\u0432\u0435\u043A,
        \u043F\u0440\u043E\u0448\u0443 \u0442\u0435\u0431\u044F, \u043F\u043E\u043C\u043E\u0433\u0438
        \u043D\u0430\u043C \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C \u043D\u0430\u0448\u0443
        \u201C\u041F\u043E\u0441\u0443\u0434\u0438\u043D\u0443\u201D, \u0438 \u043C\u044B
        \u0441\u0440\u0430\u0437\u0443 \u0436\u0435 \u0432\u0435\u0440\u043D\u0451\u043C
        \u0442\u0435\u0431\u044F \u043D\u0430 \u0417\u0435\u043C\u043B\u044E.\xBB"
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueAfterSolve.Array.data[5]'
      value: "\u0411\u043E\u0440\u0442\u043E\u0432\u043E\u0439 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440:
        \xAB\u041D\u0435 \u043F\u043E\u0441\u0443\u0434\u0438\u043D\u0443, \u0430
        \u043A\u043E\u0440\u0430\u0431\u043B\u044C \u043A\u043B\u0430\u0441\u0441\u0430
        \u0444\u0440\u0435\u0433\u0430\u0442, \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430\u2026\xBB"
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueAfterSolve.Array.data[6]'
      value: "\u041F\u0440\u0438\u0448\u0435\u043B\u0435\u0446: \xAB\u0414\u0430
        \u0437\u043D\u0430\u044E \u044F, \u043A\u043E\u043D\u0441\u0435\u0440\u0432\u0430!
        \u0427\u0435\u043B\u043E\u0432\u0435\u043A, \u0441\u043A\u043E\u0440\u0435\u0435
        \u0434\u0432\u0438\u0433\u0430\u0439\u0441\u044F \u0434\u0430\u043B\u044C\u0448\u0435!
        \u0410 \u044F \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0443 \u0430\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C.
        \u0413\u0434\u0435 \u0436\u0435 \u043C\u043E\u0439 \u0440\u0430\u0444 \u043D\u0430
        \u0443\u0433\u043B\u0435\u0432\u043E\u0434\u043D\u043E\u043C \u043C\u043E\u043B\u043E\u043A\u0435\u2026\xBB"
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueBeforeSolve.Array.data[0]'
      value: "\u041F\u0440\u0438\u0448\u0435\u043B\u0435\u0446: \xAB...[\u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u044B\u0435
        \u0437\u0432\u0443\u043A\u0438]...\xBB"
      objectReference: {fileID: 0}
    - target: {fileID: 4555226761255381679, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
      propertyPath: 'dialogueBeforeSolve.Array.data[1]'
      value: "\u0411\u043E\u0440\u0442\u043E\u0432\u043E\u0439 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440:
        \xAB\u042F\u0437\u044B\u043A \u0434\u0432\u0443\u0445 \u0432\u0438\u0434\u043E\u0432
        \u043D\u0435 \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u0435\u0442. \u0423\u043A\u0430\u0436\u0438\u0442\u0435
        \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0430\u0434\u0440\u0435\u0441
        \u0440\u043E\u0434\u043D\u043E\u0439 \u043F\u043B\u0430\u043D\u0435\u0442\u044B,
        \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C
        \u044F\u0437\u044B\u043A\u043E\u0432\u043E\u0439 \u043F\u0430\u043A\u0435\u0442
        \u0432 \u0431\u043E\u0440\u0442\u043E\u0432\u044B\u0435 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430.\xBB"
      objectReference: {fileID: 0}
    - target: {fileID: 7630290109797954153, guid: 32e2abc5f4c543b4dbe16e18f0d7cc5c, type: 3}
