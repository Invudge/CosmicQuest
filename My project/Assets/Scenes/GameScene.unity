  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#00B4FF><b>\u041F\u0420\u041E\u0422\u041E\u041A\u041E\u041B \"\u0424\u0418\u041B\u042C\u0422\u0420\"</b></color>\r\n\r\n\u0411\u043E\u0440\u0442\u043E\u0432\u043E\u0439
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440 \u0432\u044B\u044F\u0432\u0438\u043B
    6 \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445
    \u043F\u043B\u0430\u043D\u0435\u0442.\r\n\u0422\u0432\u043E\u044F \u0437\u0430\u0434\u0430\u0447\u0430:
    \u043D\u0430\u0439\u0442\u0438 \u0442\u0435, \u0447\u0442\u043E \u043F\u0440\u0438\u0433\u043E\u0434\u043D\u044B
    \u0434\u043B\u044F \u0436\u0438\u0437\u043D\u0438, \u043E\u0441\u043D\u043E\u0432\u044B\u0432\u0430\u044F\u0441\u044C
    \u043D\u0430 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0430\u0445.\r\n\r\n<color=#888888>\u041A\u0440\u0438\u0442\u0435\u0440\u0438\u0438
    \u043E\u0442\u0431\u043E\u0440\u0430:</color>\r\n\u2022 \u0422\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430
    \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C \u0432 \u0437\u0430\u0434\u0430\u043D\u043D\u043E\u043C
    \u0434\u0438\u0430\u043F\u0430\u0437\u043E\u043D\u0435.\r\n\u2022 \u041D\u0430\u043B\u0438\u0447\u0438\u0435
    \u0432\u043E\u0434\u044B \u0438 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u044B
    \u2014 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E.\r\n\r\n<color=#FF5555>\u0412\u041D\u0418\u041C\u0410\u041D\u0418\u0415:</color>\r\n\u0423
    \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C 3 \u043F\u043E\u043F\u044B\u0442\u043A\u0438.
    \u041E\u0448\u0438\u0431\u043A\u0430 \u0441\u0442\u043E\u0438\u0442 \u0436\u0438\u0437\u043D\u0438.\r\n\r\n\u041D\u0430\u0436\u043C\u0438
    <color=#00FF88>\u041D\u0410\u0427\u0410\u0422\u042C \u0410\u041D\u0410\u041B\u0418\u0417</color>,
    \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0438\u0442\u044C
    \u043A \u0441\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044E."
  m_isRightToLeft: 0
