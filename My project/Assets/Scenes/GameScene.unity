  m_Name: 
  m_EditorClassIdentifier: '::'
  revealObjects:
  - {fileID: 995779192}
  - {fileID: 693566647}
  - {fileID: 665332831}
  - {fileID: 1703105341}
  - {fileID: 286828199}
  - {fileID: 1969009698}
  - {fileID: 1256187406}
  - {fileID: 1277790535}
  - {fileID: 497551257}
  - {fileID: 359993023}
  - {fileID: 897475336}
  - {fileID: 618634325}
  originPoint: {fileID: 1141677569}
  roomBlackout: {fileID: 1311004803}
  spiralRadius: 2
  spiralTurns: 0.5
  objectsDuration: 20
  backgroundFadeDuration: 40
  timelineMessages:
  - speaker: "\u0411\u041E\u0420\u0422\u041E\u0412\u041E\u0419 \u0416\u0423\u0420\u041D\u0410\u041B"
    message: "13.8 \u043C\u043B\u0440\u0434 \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434
      \u0432\u0441\u044F \u043C\u0430\u0442\u0435\u0440\u0438\u044F \u0431\u044B\u043B\u0430
      \u0441\u0436\u0430\u0442\u0430 \u0432 \u043E\u0434\u043D\u0443 \u0442\u043E\u0447\u043A\u0443.
      \u042D\u043D\u0435\u0440\u0433\u0438\u044F, \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E
      \u0438 \u0432\u0440\u0435\u043C\u044F \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438
      \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0434\u0435\u0441\u044C."
    startTime: 0.8
    duration: 9
  - speaker: "\u0411\u041E\u0420\u0422\u041E\u0412\u041E\u0419 \u0416\u0423\u0420\u041D\u0410\u041B"
    message: "\u041F\u0440\u043E\u0438\u0437\u043E\u0448\u0451\u043B \u0441\u043A\u0430\u0447\u043E\u043A.
      \u041F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E \u043D\u0430\u0447\u0430\u043B\u043E
      \u0440\u0430\u0441\u0442\u044F\u0433\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438
      \u0441\u0432\u0435\u0442\u0430. \u042D\u0442\u043E \u0431\u044B\u043B \u043D\u0435
      \u0432\u0437\u0440\u044B\u0432 \u0432 \u043F\u0443\u0441\u0442\u043E\u0442\u0435
      \u2014 \u0440\u043E\u0441\u043B\u0430 \u0441\u0430\u043C\u0430 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C."
    startTime: 10.2
    duration: 10
  - speaker: "\u0411\u041E\u0420\u0422\u041E\u0412\u041E\u0419 \u0416\u0423\u0420\u041D\u0410\u041B"
    message: "\u042D\u043D\u0435\u0440\u0433\u0438\u044F \u043E\u0441\u0442\u044B\u043B\u0430,
      \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0432\u0448\u0438\u0441\u044C
      \u0432 \u0430\u0442\u043E\u043C\u044B. \u0418\u0437 \u044D\u0442\u043E\u0433\u043E
      \"\u0441\u0443\u043F\u0430\" \u0441\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043B\u0438\u0441\u044C
      \u0437\u0432\u0451\u0437\u0434\u044B \u0438 \u0433\u0430\u043B\u0430\u043A\u0442\u0438\u043A\u0438.
      \u0418 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0441\u044F
      \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440."
    startTime: 20.6
    duration: 10
  nextDoor: {fileID: 1995868958}
  startScale: {x: 0.01, y: 0.01, z: 1}
  parentQuest: {fileID: 1141677570}
