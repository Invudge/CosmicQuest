--- !u!114 &2143510604
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2143510602}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#00B4FF><size=28>\u0410\u041D\u0410\u041B\u0418\u0417 \u0413\u0420\u0423\u0417\u041E\u0412\u042B\u0425
    \u041A\u041E\u041D\u0422\u0415\u0419\u041D\u0415\u0420\u041E\u0412</size></color>\r\n\r\n<size=20><color=#888888>\u041D\u0430\u0443\u0447\u043D\u0430\u044F
    \u0441\u043F\u0440\u0430\u0432\u043A\u0430:</color></size>\r\n<color=#CCCCCC>\u0422\u0451\u043C\u043D\u0430\u044F
    \u043C\u0430\u0442\u0435\u0440\u0438\u044F \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    ~27% \u043C\u0430\u0441\u0441\u044B \u0412\u0441\u0435\u043B\u0435\u043D\u043D\u043E\u0439,
    \u043D\u043E \u043D\u0435 \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
    \u0441\u043E \u0441\u0432\u0435\u0442\u043E\u043C. \u0415\u0451 \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E
    \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E
    \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0442\u044C
    \u043F\u043E <b>\u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u043C\u0443
    \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044E</b>.</color>\r\n\r\n<color=#55FF55><b>\u041A\u041B\u042E\u0427\u0415\u0412\u042B\u0415
    \u0421\u0412\u041E\u0419\u0421\u0422\u0412\u0410 \u0422\u0401\u041C\u041D\u041E\u0419
    \u041C\u0410\u0422\u0415\u0420\u0418\u0418:</b></color>\r\n\u2022 <color=#FFB000></color>
    \u041E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 <b>\u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439
    \u043C\u0430\u0441\u0441\u043E\u0439</b> (\u0432\u0435\u0441\u044B \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u044E\u0442)\r\n\u2022
    <color=#FF5555></color> <b>\u041D\u0435 \u0438\u0437\u043B\u0443\u0447\u0430\u0435\u0442
    \u0441\u0432\u0435\u0442</b> (\u043D\u0435 \u0441\u0432\u0435\u0442\u0438\u0442\u0441\u044F,
    \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u0430)\r\n\u2022 <color=#FF5555></color>
    <b>\u041D\u0435 \u043F\u043E\u0433\u043B\u043E\u0449\u0430\u0435\u0442 \u0441\u0432\u0435\u0442</b>
    (\u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u0430 \u0434\u043B\u044F \u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F)\r\n\r\n<size=20><color=#888888>\u0412\u0410\u0428\u0410
    \u0417\u0410\u0414\u0410\u0427\u0410:</color></size>\r\n1. \u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435
    \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440 \u043D\u0430 <color=#FFB000>\u0432\u0435\u0441\u044B</color>
    \u0434\u043B\u044F \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F \u043C\u0430\u0441\u0441\u044B\r\n2.
    \u041E\u0431\u0440\u0430\u0442\u0438\u0442\u0435 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
    \u043D\u0430 <color=#AAAAAA>\u0441\u0432\u0435\u0447\u0435\u043D\u0438\u0435</color>
    \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u0430\r\n3. \u041D\u0430\u0439\u0434\u0438\u0442\u0435
    \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440: <color=#55FF55>\u041C\u0410\u0421\u0421\u0410
    = \u0414\u0410</color> + <color=#FF5555>\u0421\u0412\u0415\u0422 = \u041D\u0415\u0422</color>\r\n4.
    \u041D\u0430\u0436\u043C\u0438\u0442\u0435 <b>\"\u0417\u0410\u0413\u0420\u0423\u0417\u0418\u0422\u042C
    \u0412 \u0414\u0412\u0418\u0413\u0410\u0422\u0415\u041B\u042C\"</b> \u0434\u043B\u044F
    \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438\r\n\r\n\r\n<size=24><color=#00FF88>\u041D\u0430\u0439\u0434\u0438\u0442\u0435
    \u0442\u0451\u043C\u043D\u0443\u044E \u043C\u0430\u0442\u0435\u0440\u0438\u044E
    \u0438 \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u044C!</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
