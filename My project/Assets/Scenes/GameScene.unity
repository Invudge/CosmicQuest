  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u0447\u0442\u043E
    \u0441\u043B\u043E\u043C\u0430\u043B\u0430\u0441\u044C \u0441\u0438\u0441\u0442\u0435\u043C\u0430
    \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438 \u043A\u043E\u0440\u0430\u0431\u043B\u044F,
    \u0438 \u043C\u044B \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u044B.
    \u0427\u0442\u043E\u0431\u044B \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    \u043C\u0430\u0440\u0448\u0440\u0443\u0442, \u0432\u0440\u0443\u0447\u043D\u0443\u044E
    \u0432\u0432\u0435\u0434\u0438\u0442\u0435 \u0430\u0434\u0440\u0435\u0441 \u043C\u0435\u0441\u0442\u043E\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F:
    \u043E\u0442 \u0412\u0441\u0435\u043B\u0435\u043D\u043D\u043E\u0439 \u0434\u043E
    \u0432\u0430\u0448\u0435\u0439 \u043F\u043B\u0430\u043D\u0435\u0442\u044B. \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435
    \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442
    \u0432 \u043A\u0430\u0436\u0434\u043E\u0439 \u0441\u0442\u0440\u043E\u043A\u0435
